#: package/contents/ui/config/ConfigServices.qml:145
msgid ""
"{language} and {code} become the language to translate into (français, fr), "
"{lines} the lyrics as numbered lines. The answer must keep the numbers, as "
"\"number| translation\"."
msgstr ""
"{language} et {code} deviennent la langue cible (français, fr), {lines} les "
"paroles en lignes numérotées. La réponse doit garder les numéros, sous la "
"forme \"numéro| traduction\"."

#: package/contents/ui/config/ConfigServices.qml:151
msgid "Default"
msgstr "Par défaut"

#: package/contents/ui/config/ConfigServices.qml:159
msgid "No machine translation"
msgstr "Pas de traduction automatique"

#: package/contents/ui/config/ConfigServices.qml:165
msgid "Also translate the lyrics Deezer provides"
msgstr "Traduire aussi les paroles fournies par Deezer"

#: package/contents/ui/config/ConfigServices.qml:173
msgid ""
"Deezer's lyrics are licensed from LyricFind for personal use: this sends "
"them to the chosen engine. Lyrics from LRCLIB are always translated."
msgstr ""
"Les paroles de Deezer sont sous licence LyricFind, pour un usage personnel : "
"cette option les envoie au moteur choisi. Les paroles de LRCLIB sont "
"toujours traduites."

#: package/contents/ui/config/ConfigServices.qml:178
msgid "Cache"
