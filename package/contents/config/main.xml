<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <!-- Popup size of each view, in pixels; 0 means not resized yet. -->
    <group name="General">
        <entry name="playerWidth" type="Int">
            <default>0</default>
        </entry>
        <entry name="playerHeight" type="Int">
            <default>0</default>
        </entry>
        <entry name="webWidth" type="Int">
            <default>0</default>
        </entry>
        <entry name="webHeight" type="Int">
            <default>0</default>
        </entry>
        <!-- Keeps the popup open when it loses focus. -->
        <entry name="pin" type="Bool">
            <default>false</default>
        </entry>

        <!-- Language of the Deezer site: empty for the system's. -->
        <entry name="deezerLanguage" type="String">
            <default></default>
        </entry>

        <!-- Music when Plasma starts: resumed after a plasmashell restart if it
             was playing, or started when the session opens. -->
        <entry name="resumePlayback" type="Bool">
            <default>true</default>
        </entry>
        <entry name="playAtLogin" type="Bool">
            <default>false</default>
        </entry>

        <!-- Panel icon wheel: volume step in percent, and direction. -->
        <entry name="wheelStep" type="Int">
            <default>5</default>
        </entry>
        <entry name="invertWheel" type="Bool">
            <default>false</default>
        </entry>
        <!-- Panel icon: "widget" (the widget's own), "favicon" (deezer.com's,
             as the page loads it) or "custom" (panelIconCustom). -->
        <entry name="panelIcon" type="String">
            <default>widget</default>
        </entry>
        <!-- Icon name or file picked by the user, kept when another choice is made. -->
        <entry name="panelIconCustom" type="String">
            <default></default>
        </entry>

        <!-- Machine translation of lyrics Deezer does not translate:
             "google", "libretranslate", "ollama" or "none". -->
        <entry name="translationEngine" type="String">
            <default>google</default>
        </entry>
        <entry name="libreTranslateUrl" type="String">
            <default>http://127.0.0.1:5000</default>
        </entry>
        <entry name="ollamaUrl" type="String">
            <default>http://127.0.0.1:11434</default>
        </entry>
        <entry name="ollamaModel" type="String">
            <default>translategemma</default>
        </entry>
        <!-- Prompt for Ollama, with {language}, {code} and {lines} in it
             (see translate.js); empty for the default one. -->
        <entry name="ollamaPrompt" type="String">
            <default></default>
        </entry>
        <!-- Also ask lrcmux, an aggregator of unofficial lyrics sources. -->
        <entry name="extendedLyrics" type="Bool">
            <default>false</default>
        </entry>
        <!-- Also send Deezer's lyrics (licensed from LyricFind) to Google; the
             user's own LibreTranslate or Ollama server always gets them. -->
        <entry name="translateDeezerLyrics" type="Bool">
            <default>false</default>
        </entry>

        <!-- Lyrics look: text size factor, and fade strength around the sung
             line, 0 (none) to 100. -->
        <entry name="lyricsFontScale" type="Double">
            <default>1.0</default>
        </entry>
        <entry name="lyricsFade" type="Int">
            <default>100</default>
        </entry>
        <!-- Behind the lyrics: "cover" (blurred, text color to suit it),
             "light" (black on white) or "dark" (white on black). -->
        <entry name="lyricsBackground" type="String">
            <default>cover</default>
        </entry>
        <!-- How much the cover is blurred behind the lyrics, 0 to 100. -->
        <entry name="lyricsBlur" type="Int">
            <default>100</default>
        </entry>

        <!-- Web engine HTTP cache limit, in megabytes. -->
        <entry name="webCacheLimit" type="Int">
            <default>300</default>
        </entry>
        <!-- Set by the settings to ask the widget to empty its web cache. -->
        <entry name="webCacheClearRequest" type="String">
            <default></default>
        </entry>
    </group>
</kcfg>
